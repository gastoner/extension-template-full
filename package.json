{
  "name": "chaos-lab",
  "displayName": "Chaos Lab",
  "description": "Chaos engineering toolkit for Podman Desktop",
  "version": "1.4.0-next",
  "icon": "icon.png",
  "publisher": "yourusername",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "concurrently \"cd packages/frontend && pnpm run build\" \"cd packages/backend && pnpm run build\"",
    "watch": "concurrently \"cd packages/frontend && pnpm run watch\" \"cd packages/backend && pnpm run watch\"",
    "format:check": "prettier --check \"**/src/**/*.{ts,svelte}\"",
    "format:fix": "prettier --write \"**/src/**/*.{ts,svelte}\"",
    "lint:check": "eslint . --ext js,ts,tsx",
    "lint:fix": "eslint . --fix --ext js,ts,tsx",
    "svelte:check": "cd packages/frontend && pnpm check",
    "test:backend": "vitest run -r packages/backend --passWithNoTests --coverage",
    "test:frontend": "pnpm run --dir ./packages/frontend test",
    "test:shared": "vitest run -r packages/shared --passWithNoTests --coverage",
    "test": "pnpm run test:backend && pnpm run test:shared && pnpm run test:frontend",
    "typecheck:shared": "tsc --noEmit --project packages/shared",
    "typecheck:frontend": "cd packages/frontend && pnpm check",
    "typecheck:backend": "tsc --noEmit --project packages/backend",
    "typecheck": "pnpm run typecheck:shared && pnpm run typecheck:frontend && pnpm run typecheck:backend"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.1.0",
    "@typescript-eslint/parser": "^8.0.1",
    "@vitest/coverage-v8": "^4.1.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-import-resolver-custom-alias": "^1.3.2",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-etc": "^2.0.3",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-no-null": "^1.0.2",
    "eslint-plugin-redundant-undefined": "^1.0.0",
    "eslint-plugin-sonarjs": "^1.0.4",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.55.7",
    "svelte-check": "^4.2.0",
    "typescript": "5.5.4",
    "vite": "8.0.16",
    "vitest": "^4.1.0"
  },
  "dependencies": {},
  "packageManager": "pnpm@10.11.0"
}
