{
  "name": "chaos-lab",
  "displayName": "Chaos Lab",
  "description": "Chaos engineering toolkit for Podman Desktop",
  "version": "0.1.0",
  "icon": "icon.png",
  "publisher": "yourusername",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0",
    "podman-desktop": ">=1.17.0"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "chaos-lab.stopAll",
        "title": "Chaos Lab: Stop All Chaos"
      },
      {
        "command": "chaos-lab.toggleChaosMode",
        "title": "Chaos Lab: Toggle Chaos Mode"
      },
      {
        "command": "chaos-lab.runScenario",
        "title": "Chaos Lab: Run Scenario"
      },
      {
        "command": "chaos-lab.revertAll",
        "title": "Chaos Lab: Revert All Containers"
      },
      {
        "command": "chaos-lab.revertContainer",
        "title": "Chaos Lab: Revert Container"
      }
    ],
    "menus": {},
    "configuration": {
      "title": "Chaos Lab",
      "properties": {
        "chaos-lab.chaosSafeContainers": {
          "type": "string",
          "default": "",
          "description": "Comma-separated container name patterns that should never be targeted by chaos or isolation (supports * wildcards). Example: 'postgres*,redis-prod'."
        },
        "chaos-lab.showStatusBarChaos": {
          "type": "boolean",
          "default": true,
          "description": "Show the Chaos mode indicator in the status bar."
        },
        "chaos-lab.showNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show toast notifications when chaos actions fire."
        }
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "lint:check": "eslint . --ext js,ts,tsx",
    "lint:fix": "eslint . --fix --ext js,ts,tsx",
    "watch": "vite --mode development build -w"
  },
  "devDependencies": {
    "@podman-desktop/api": "1.12.0",
    "@types/node": "^24",
    "@typescript-eslint/eslint-plugin": "^8.1.0",
    "@typescript-eslint/parser": "^6.16.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^8.56.0",
    "eslint-import-resolver-custom-alias": "^1.3.2",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-etc": "^2.0.3",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-no-null": "^1.0.2",
    "eslint-plugin-redundant-undefined": "^1.0.0",
    "eslint-plugin-sonarjs": "^1.0.4",
    "prettier": "^3.3.3",
    "typescript": "5.5.4",
    "vite": "8.0.16",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
